<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>src\app.ico</ApplicationIcon>
    <StartupObject>Glance.Program</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Low-Memory & High-Performance Desktop Optimizations for .NET 8 -->
    <!-- Workstation GC: Minimizes GC working set for desktop utilities -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Non-concurrent GC: Reclaims memory aggressively without holding background buffers -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Enable DATAS (Dynamic Adaptation To Application Sizes) in .NET 8 -->
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\SetupInstaller.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
